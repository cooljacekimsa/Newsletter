rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings: browser can read & write (no auth in MVP)
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Articles: browser read-only; Functions (admin SDK) bypasses rules
    match /articles/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Newsletters: browser can read and delete
    match /newsletters/{docId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if false;
    }

    // Logs: browser can read and delete
    match /logs/{docId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if false;
    }

    // Review crawl runs: browser can read and delete
    match /reviewCrawls/{docId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if false;
    }

    // Review items: browser read-only; Actions (admin SDK) bypasses rules
    match /reviewItems/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
